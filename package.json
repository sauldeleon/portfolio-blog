  "scripts": {
    "nx": "nx",
    "start:web": "nx serve web",
    "start:web:e2e": "node scripts/start-web-e2e.mjs",
    "build": "nx build",
    "build:all": "NODE_ENV=production nx run-many --target=build --all",
    "build:web": "NODE_ENV=production yarn build web",
    "test:web": "env -u NO_COLOR NODE_ENV=test nx test web",
    "test:libs": "env -u NO_COLOR NODE_ENV=test nx run-many --all --target=test --exclude $(nx print-affected --select=projects --type=app) \\'*-e2e\\'",
    "test:all": "env -u NO_COLOR NODE_ENV=test nx run-many --all --target=test --exclude '*-e2e'",
    "analyse:web": "ANALYZE=true yarn build:web",
