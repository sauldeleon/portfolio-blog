// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`BlurUp > matches snapshot 1`] = `
.c0 {
  position: relative;
  display: block;
  overflow: hidden;
  width: 100%;
}

:where(.c0 > img[data-blur-up]) {
  position: relative;
  z-index: 1;
  transition: opacity 0.6s ease-out;
}

:where(.c0 > img[data-blur-up]:not([data-loaded])) {
  opacity: 0;
}

:where(.c0 > img[data-blur-up]:not([data-loaded])) {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.c0:has(> img[data-loaded])>img[aria-hidden] {
  position: absolute;
  inset: 0;
  height: 100%;
}

.c1 {
  display: block;
  width: 100%;
  height: auto;
  filter: blur(12px);
  transform: scale(1.1);
}

<div>
  <span
    class="c0"
    data-testid="blur-up"
  >
    <img
      alt=""
      aria-hidden="true"
      class="c1"
      data-testid="blur-placeholder"
      src="https://res.cloudinary.com/x/image/upload/w_32/a.jpg"
    />
    <img
      alt="Full"
      data-blur-up=""
      src="/full.jpg"
    />
  </span>
</div>
`;
