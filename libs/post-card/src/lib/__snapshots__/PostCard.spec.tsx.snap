exports[`PostCard > matches snapshot 1`] = `
.c4 {
  position: absolute;
  display: block;
  overflow: hidden;
  inset: 0;
}

:where(.c4 > img[data-blur-up]) {
  position: relative;
  z-index: 1;
  transition: opacity 0.6s ease-out;
}

:where(.c4 > img[data-blur-up]:not([data-loaded])) {
  opacity: 0;
}

.c5 {
  display: block;
  width: 100%;
  height: 100%;
  filter: blur(12px);
  transform: scale(1.1);
  position: absolute;
  inset: 0;
}

.c1 {
  display: flex;
  flex-direction: column;
  background: linear-gradient(         #000000,         #000000       ) padding-box,linear-gradient(         135deg,         #98DFD64d 0%,         #FFDD834d 100%       ) border-box;
  border: 1px solid transparent;
  overflow: hidden;
  position: relative;
  transition: background 0.2s ease;
}

.c1:hover {
  background: linear-gradient(           #000000,           #000000         ) padding-box,linear-gradient(           135deg,           #98DFD6 0%,           #FFDD83 100%         ) border-box;
}

.c2 {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.c3 {
  position: relative;
  aspect-ratio: 16/9;
  overflow: hidden;
  background-color: #0d0d0d;
}

.c3 img:not([aria-hidden]) {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease,opacity 0.6s ease-out;
  display: block;
}

.c0:hover .c3 img:not([aria-hidden]) {
  transform: scale(1.05);
}

.c6 {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding: 1rem 1.25rem 1.25rem;
  flex: 1;
}

.c7 {
  font-family: var(--font-roboto-mono);
  font-weight: 500;
  color: #FBFBFB;
  font-size: 0.5rem;
  line-height: normal;
  text-transform: uppercase;
  color: #98DFD6;
}

.c8 {
  font-family: var(--font-roboto-mono);
  font-weight: 400;
  color: #FBFBFB;
  font-size: 1rem;
  line-height: normal;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.c9 {
  font-family: var(--font-roboto-mono);
  font-weight: 400;
  color: #FBFBFB;
  font-size: 0.8rem;
  line-height: normal;
  margin: 0;
  opacity: 0.6;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex: 1;
}

.c10 {
  font-family: var(--font-roboto-mono);
  font-weight: 500;
  color: #FBFBFB;
  font-size: 0.55rem;
  line-height: normal;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.25rem 0.75rem;
  opacity: 0.45;
  margin-top: 0.25rem;
}

.c11 {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.c12 {
  font-family: var(--font-roboto-mono);
  font-weight: 500;
  color: #FBFBFB;
  font-size: 0.55rem;
  line-height: normal;
  padding: 0.125rem 0.5rem;
  border: 1px solid #98DFD6;
  color: #98DFD6;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.c13 {
  font-family: var(--font-roboto-mono);
  font-weight: 500;
  color: #FBFBFB;
  font-size: 0.55rem;
  line-height: normal;
  color: #FFDD83;
  text-decoration: none;
  display: inline-block;
  align-self: flex-start;
  margin-top: 0.75rem;
  position: relative;
  z-index: 1;
}

.c13::after {
  content: '';
  position: absolute;
  width: 100%;
  height: 1px;
  bottom: 0;
  left: 0;
  background-color: currentColor;
  transform: scaleX(0);
  transform-origin: bottom right;
  transition: transform 0.2s ease-out;
}

.c13:hover::after {
  transform: scaleX(1);
  transform-origin: bottom left;
}

<body>
